{
  "name": "html-css-to-image/client",
  "description": "Official PHP client for the HTML/CSS to Image API",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "HTML/CSS to Image API",
      "email": "support@htmlcsstoimage.com",
      "homepage": "https://htmlcsstoimage.com"
    }
  ],
  "keywords": [
    "html-to-image",
    "screenshot",
    "hcti",
    "htmlcsstoimage"
  ],
  "homepage": "https://htmlcsstoimage.com",
  "support": {
    "docs": "https://docs.htmlcsstoimage.com",
    "issues": "https://github.com/htmlcsstoimage/php-client/issues",
    "source": "https://github.com/htmlcsstoimage/php-client"
  },
  "require": {
    "php": "^8.2",
    "composer-runtime-api": "^2.0",
    "guzzlehttp/guzzle": "^7.15.2",
    "guzzlehttp/psr7": "^2.7",
    "psr/http-client": "^1.0",
    "psr/http-message": "^1.1 || ^2.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "HtmlCssToImage\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "HtmlCssToImage\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "analyse": "phpstan analyse --no-progress",
    "test": "phpunit"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
